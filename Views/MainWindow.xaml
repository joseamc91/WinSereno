<Window Style="{StaticResource {x:Type Window}}" x:Class="WinSereno.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Text.Winsereno}" Width="1180" Height="820" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ItemsPanelTemplate x:Key="DiskCardsPanel"><WrapPanel/></ItemsPanelTemplate>
    <DataTemplate x:Key="DiskCardTemplate">
      <Border Style="{StaticResource Card}" Width="252" Padding="12" Margin="0,0,10,10"><StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,5"/>
        <WrapPanel><TextBlock Text="{Binding FreeText}" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{DynamicResource Text.Separator}" Style="{StaticResource Muted}" FontSize="12"/>
          <TextBlock Text="{Binding StatusText}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/><Style.Triggers><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </WrapPanel>
      </StackPanel></Border>
    </DataTemplate>
    <DataTemplate x:Key="SidebarNavigationTemplate">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center">
          <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource NavigationHomeIcon}"/><Setter Property="Stroke" Value="{DynamicResource MutedBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SectionCode}" Value="Diagnosis"><Setter Property="Data" Value="{StaticResource NavigationDiagnosisIcon}"/></DataTrigger>
              <DataTrigger Binding="{Binding SectionCode}" Value="Repair"><Setter Property="Data" Value="{StaticResource NavigationRepairIcon}"/></DataTrigger>
              <DataTrigger Binding="{Binding SectionCode}" Value="Network"><Setter Property="Data" Value="{StaticResource NavigationNetworkIcon}"/></DataTrigger>
              <DataTrigger Binding="{Binding SectionCode}" Value="Cleanup"><Setter Property="Data" Value="{StaticResource NavigationCleanupIcon}"/></DataTrigger>
              <DataTrigger Binding="{Binding SectionCode}" Value="Activity"><Setter Property="Data" Value="{StaticResource NavigationActivityIcon}"/></DataTrigger>
              <DataTrigger Binding="{Binding SectionCode}" Value="Settings"><Setter Property="Data" Value="{StaticResource NavigationSettingsIcon}"/></DataTrigger>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Stroke" Value="{DynamicResource TextBrush}"/></DataTrigger>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/></DataTrigger>
            </Style.Triggers>
          </Style></Path.Style>
        </Path>
        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
    <Style x:Key="CleanupCategoryCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="30"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid x:Name="HitArea" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="CheckShell" Width="20" Height="20" CornerRadius="3" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1">
            <Path x:Name="CheckMark" Data="M 3,9 L 7,13 L 15,4" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/><Setter TargetName="CheckShell" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="CheckShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckShell" Property="BorderThickness" Value="2"/><Setter TargetName="CheckShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HitArea" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <ItemsPanelTemplate x:Key="ThreeColumnCardPanel"><UniformGrid Columns="3"/></ItemsPanelTemplate>
    <Style x:Key="ThreeColumnCards" TargetType="ItemsControl">
      <Setter Property="ItemsPanel" Value="{StaticResource ThreeColumnCardPanel}"/>
      <!-- Half-gaps are cancelled at the outside edges; the cards align with the page header. -->
      <Setter Property="Margin" Value="-5,0,-5,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="ThreeColumnCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="5,0,5,10"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="RepairSessionResultText" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,4,0,0"/><Style.Triggers><DataTrigger Binding="{Binding ResultText}" Value="Sin resultados durante esta sesión."><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="NetworkToolResultText" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,4,0,0"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Sin resultados durante esta sesión."><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
    <DataTemplate x:Key="ToolTemplate"><Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="{DynamicResource Text.ComingSoon}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="16,0,0,0"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate>
  </Window.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" Padding="20,28,20,20"><Grid x:Name="SidebarLayout">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Image x:Name="SidebarBrandLogo" Source="{DynamicResource BrandLogoImage}" Width="180" Height="60" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Text.Winsereno}"/>
      <ListBox x:Name="MainNavigationList" Grid.Row="1" ItemsSource="{Binding MainNavigation}" SelectedItem="{Binding SelectedMainNavigation, Mode=TwoWay}" ItemContainerStyle="{StaticResource SidebarItem}" ItemTemplate="{StaticResource SidebarNavigationTemplate}" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="OnNavigationKeyDown"/>
      <StackPanel Grid.Row="2" Margin="0,20,0,0">
        <ListBox x:Name="SettingsNavigationList" ItemsSource="{Binding SettingsNavigation}" SelectedItem="{Binding SelectedSettingsNavigation, Mode=TwoWay}" ItemContainerStyle="{StaticResource SidebarItem}" ItemTemplate="{StaticResource SidebarNavigationTemplate}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14" KeyDown="OnNavigationKeyDown"/>
        <TextBlock Text="{Binding ProductVersion}" Style="{StaticResource Muted}" FontSize="12"/>
        <Button Content="{DynamicResource Text.Github}" Command="{Binding OpenGitHubCommand}" Style="{StaticResource LinkButton}" Margin="0,3,0,0"/>
      </StackPanel>
    </Grid></Border>
    <Grid x:Name="MainArea" Grid.Column="1" Margin="28,28,28,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18"><TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding PageDescription}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
      <Border Grid.Row="1" Visibility="{Binding HasPageNotice, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource BannerBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,18"><TextBlock Text="{Binding PageNotice}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/></Border>
      <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding CurrentSectionCode}" Value="Repair"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <Grid>
          <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSectionCode}" Value="Home"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <DockPanel Margin="0,0,0,10"><Button Content="{DynamicResource Text.Refresh}" DockPanel.Dock="Right" Command="{Binding Home.RefreshCommand}" Margin="12,0,0,0"/><TextBlock Text="{Binding Home.RefreshedText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
            <ItemsControl x:Name="HomeInformationCards" Style="{StaticResource ThreeColumnCards}" ItemsSource="{Binding Home.Cards}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ThreeColumnCard}"><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Value}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,5"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{DynamicResource Text.LocalDisks}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
            <TextBlock Text="{Binding Home.DisksMessage}" Style="{StaticResource Muted}" Visibility="{Binding Home.HasDisksMessage, Converter={StaticResource BoolVisibility}}"/>
            <ItemsControl x:Name="LocalDiskCards" ItemsSource="{Binding Home.LocalDisks}" ItemsPanel="{StaticResource DiskCardsPanel}" ItemTemplate="{StaticResource DiskCardTemplate}"/>
            <StackPanel x:Name="ExternalDisksSection" Visibility="{Binding Home.HasExternalDisks, Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="{DynamicResource Text.ExternalDrives}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
              <TextBlock Text="{Binding Home.ExternalDisksMessage}" Style="{StaticResource Muted}" Visibility="{Binding Home.HasExternalDisksMessage, Converter={StaticResource BoolVisibility}}"/>
              <ItemsControl x:Name="ExternalDiskCards" ItemsSource="{Binding Home.ExternalDisks}" ItemsPanel="{StaticResource DiskCardsPanel}" ItemTemplate="{StaticResource DiskCardTemplate}"/>
            </StackPanel>

          </StackPanel>
          <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSectionCode}" Value="Diagnosis"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Border x:Name="DiagnosticSummaryCard" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <WrapPanel x:Name="DiagnosticControls" VerticalAlignment="Center" Margin="0,0,12,0">
                  <Button Content="{Binding Diagnosis.AnalyzeLabel}" Command="{Binding Diagnosis.AnalyzeCommand}" Style="{StaticResource PrimaryButton}" Padding="10,6"/>
                  <Button Content="{DynamicResource Text.CancelDiagnostics}" Command="{Binding Diagnosis.CancelCommand}" Padding="10,6" Visibility="{Binding Diagnosis.IsRunning, Converter={StaticResource BoolVisibility}}"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Diagnosis.Summary}" FontWeight="SemiBold" TextAlignment="Right"/>
                  <WrapPanel HorizontalAlignment="Right" Margin="0,5,0,0">
                    <TextBlock Text="{Binding Diagnosis.HealthyCount, StringFormat={}{0} Correctos}" Foreground="{DynamicResource GoodBrush}"/>
                    <TextBlock Text="{DynamicResource Text.Separator}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding Diagnosis.AttentionCount, StringFormat={}{0} Atención}" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="{DynamicResource Text.Separator}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding Diagnosis.ErrorCount, StringFormat={}{0} Errores}" Foreground="{DynamicResource ErrorBrush}"/>
                    <TextBlock Text="{DynamicResource Text.Separator}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding Diagnosis.NotCheckedCount, StringFormat={}{0} No comprobado}" Style="{StaticResource Muted}"/>
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Diagnosis.Results}"><ItemsControl.ItemTemplate><DataTemplate><ContentControl Loaded="OnDiagnosticHostLoaded"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
          <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSectionCode}" Value="Repair"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <ItemsControl Focusable="False" ItemsSource="{Binding RealRepairTasks}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Task.Id}" Value="repair.complete"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding Task.Name}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Text.ChecksWindowsIntegrityAndRepairsDetectedProblemsWhen}" Margin="0,6,0,0"/>
                    <TextBlock Text="{DynamicResource Text.ScanhealthRestorehealthIfNeededSfc}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="{Binding ButtonLabel}" Command="{Binding DataContext.RunRepairCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Task.Id}" Style="{StaticResource PrimaryButton}" Margin="0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ResultText}" Style="{StaticResource RepairSessionResultText}" Margin="0,8,0,0"/>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{DynamicResource Text.IndividualTools}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
            <Border Style="{StaticResource Card}" Padding="12,0">
              <ItemsControl Focusable="False" ItemsSource="{Binding RealRepairTasks}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Task.Id}" Value="repair.complete"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                      <TextBlock x:Name="RepairToolTitle" TextWrapping="Wrap"><Run Text="{Binding DisplayTitle, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{DynamicResource Text.Separator}" Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding DisplayTechnicalName, Mode=OneWay}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                      <TextBlock Text="{Binding DisplayDescription}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                      <TextBlock Text="{Binding ResultText}" Style="{StaticResource RepairSessionResultText}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding ButtonLabel}" Command="{Binding DataContext.RunRepairCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Task.Id}" FontSize="13" Padding="10,6" Margin="0" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </Border>
            <ItemsControl Focusable="False" ItemsSource="{Binding RepairTools}" ItemTemplate="{StaticResource ToolTemplate}"/>
          </StackPanel>
          <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSectionCode}" Value="Network"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Grid x:Name="NetworkStatusHeader" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button Grid.Column="1" Content="{DynamicResource Text.Refresh}" Command="{Binding Network.RefreshCommand}" Margin="12,0,0,0" Padding="10,6"/>
              <TextBlock x:Name="NetworkConnectivityHeading" VerticalAlignment="Center"><Run Text="{DynamicResource Text.NetworkStatus}" FontSize="18" FontWeight="SemiBold"/><Run Text="{DynamicResource Text.Separator}" Foreground="{DynamicResource MutedBrush}"/>
                <Run Text="{Binding Network.ConnectivityStatusText, Mode=OneWay}"><Run.Style><Style TargetType="Run"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers>
                  <DataTrigger Binding="{Binding Network.ConnectivityStatusCode}" Value="Healthy"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Network.ConnectivityStatusCode}" Value="Attention"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Network.ConnectivityStatusCode}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Network.ConnectivityStatusCode}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                </Style.Triggers></Style></Run.Style></Run>
              </TextBlock>
            </Grid>
            <TextBlock Text="{Binding Network.RefreshedText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,10"/>
            <ItemsControl x:Name="NetworkAdapterCards" Style="{StaticResource ThreeColumnCards}" ItemsSource="{Binding Network.Adapters}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource ThreeColumnCard}"><Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/>
                    <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse x:Name="NetworkStateDot" Width="7" Height="7" Margin="0,0,5,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource MutedBrush}"/><Style.Triggers>
                      <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource GoodBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Desconectado"><Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                    </Style.Triggers></Style></Ellipse.Style></Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12"/>
                  </Grid></Grid>
                  <TextBlock Text="{Binding CardName}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" Visibility="{Binding HasCardName, Converter={StaticResource BoolVisibility}}"/>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" Visibility="{Binding HasInterfaceName, Converter={StaticResource BoolVisibility}}"/>
                  <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding LinkSpeed}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,10,0" Visibility="{Binding HasLinkSpeed, Converter={StaticResource BoolVisibility}}"/>
                    <TextBlock Text="{Binding IPv4, StringFormat=IPv4: {0}}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding HasIPv4, Converter={StaticResource BoolVisibility}}"/>
                  </WrapPanel>
                  </StackPanel>
                  <Expander Grid.Row="2" Header="{DynamicResource Text.AdapterDetails}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0">
                    <StackPanel Margin="0,4,0,0">
                      <TextBlock Text="{DynamicResource Text.AdditionalInformationUnavailable}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAdditionalDetails}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      <TextBlock Text="{Binding Gateway, StringFormat=Gateway: {0}}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding HasGateway, Converter={StaticResource BoolVisibility}}"/>
                      <TextBlock Text="{Binding Dns, StringFormat=DNS: {0}}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding HasDns, Converter={StaticResource BoolVisibility}}"/>
                      <TextBlock Text="{Binding WifiDetails}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding HasWifiDetails, Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                  </Expander>
                </Grid></Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="{DynamicResource Text.ConnectivityDetails}" Margin="0,0,0,12" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding Network.HasConnectivityDetails, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Network.Connectivity}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></Expander>
            <Border Style="{StaticResource Card}" Padding="12,0"><StackPanel>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Network.FlushDnsTask.Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Network.FlushDnsTask.ShortDescription}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Network.FlushDnsResultText}" Tag="{Binding Network.FlushDnsResultText}" Style="{StaticResource NetworkToolResultText}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Text.FlushDnsCache}" Command="{Binding FlushDnsCommand}" FontSize="13" Padding="10,6" Margin="0" VerticalAlignment="Center"/>
              </Grid></Border>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Network.RenewDhcpTask.Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Network.RenewDhcpTask.ShortDescription}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Network.DhcpResultText}" Tag="{Binding Network.DhcpResultText}" Style="{StaticResource NetworkToolResultText}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Text.RenewDhcpAddress}" Command="{Binding RenewDhcpCommand}" FontSize="13" Padding="10,6" Margin="0" VerticalAlignment="Center"/>
              </Grid></Border>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Network.RestartAdapterTask.Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Network.RestartAdapterTask.ShortDescription}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Network.RestartResultText}" Tag="{Binding Network.RestartResultText}" Style="{StaticResource NetworkToolResultText}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Text.RestartNetworkAdapter}" Command="{Binding RestartAdapterCommand}" FontSize="13" Padding="10,6" Margin="0" VerticalAlignment="Center"/>
              </Grid></Border>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Network.ResetWinsockTask.Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Network.ResetWinsockTask.ShortDescription}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                  <TextBlock Text="{DynamicResource Text.WindowsMayNeedToBeRestartedItNever}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Network.WinsockResultText}" Tag="{Binding Network.WinsockResultText}" Style="{StaticResource NetworkToolResultText}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Text.ResetWinsock}" Command="{Binding ResetWinsockCommand}" FontSize="13" Padding="10,6" Margin="0" VerticalAlignment="Center"/>
              </Grid></Border>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Network.ResetTcpIpTask.Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Network.ResetTcpIpTask.ShortDescription}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                  <TextBlock Text="{DynamicResource Text.MayInterruptConnectivityWindowsWillUsuallyNeedTo}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Network.TcpIpResultText}" Tag="{Binding Network.TcpIpResultText}" Style="{StaticResource NetworkToolResultText}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Text.ResetTcpIp}" Command="{Binding ResetTcpIpCommand}" FontSize="13" Padding="10,6" Margin="0" VerticalAlignment="Center"/>
              </Grid></Border>
            </StackPanel></Border>
            <ItemsControl ItemsSource="{Binding NetworkTools}" ItemTemplate="{StaticResource ToolTemplate}"/>
          </StackPanel>
          <StackPanel x:Name="CleanupPage"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSectionCode}" Value="Cleanup"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Cleanup.SelectionSummary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <WrapPanel Grid.Column="1"><Button Content="{Binding Cleanup.AnalyzeLabel}" Command="{Binding Cleanup.AnalyzeCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="{DynamicResource Text.CleanSelectedCategories}" Command="{Binding CleanSelectedCommand}" Margin="0"/></WrapPanel>
            </Grid>
            <TextBlock Text="{Binding Cleanup.Summary}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Card}" Padding="12,0">
              <ItemsControl ItemsSource="{Binding Cleanup.Categories}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                      <CheckBox Style="{StaticResource CleanupCategoryCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding DataContext.Cleanup.CanChangeSelection, RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></CheckBox>
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" Margin="30,3,0,0" Visibility="{Binding HasAmounts, Converter={StaticResource BoolVisibility}}"/>
                      <TextBlock Text="{Binding ElevatedAnalysisText}" Style="{StaticResource Muted}" FontSize="11" Margin="30,3,0,0" Visibility="{Binding HasElevatedAnalysisTime, Converter={StaticResource BoolVisibility}}"/>
                      <Expander Header="{DynamicResource Text.Details}" Margin="30,4,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}">
                        <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Result.WasAnalyzed}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                        <TextBlock Text="{Binding DisplayPath}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
                      </Expander>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="12"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <Button Content="{DynamicResource Text.EmptyRecycleBin}" Command="{Binding DataContext.EmptyRecycleBinCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,6" Margin="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRecycleBin}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                      <Button Content="{DynamicResource Text.Clean}" Command="{Binding DataContext.CleanThumbnailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,6" Margin="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsThumbnailCache}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                      <Button Content="{DynamicResource Text.Clean}" Command="{Binding DataContext.CleanWindowsTempCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,6" Margin="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsWindowsTemporary}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                      <Button Content="{DynamicResource Text.Clean}" Command="{Binding DataContext.CleanUserTempCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,6" Margin="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsUserTemporary}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </Border>
          </StackPanel>
          <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSectionCode}" Value="Activity"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="{DynamicResource Text.NoActionsHaveBeenPerformedInThisSession}" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><DataTrigger Binding="{Binding HasHistory}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <ItemsControl ItemsSource="{Binding ActionHistory}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource Card}" Padding="12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,4,0,0"><TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,14,0"/><TextBlock Text="{Binding StateText}" FontSize="12" Margin="0,0,14,0"/><TextBlock Text="{Binding DurationText}" Style="{StaticResource Muted}" FontSize="12"/></WrapPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="{DynamicResource Text.ViewDetails}" Command="{Binding DataContext.HistoryDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" Padding="10,6" Margin="0"/>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
          <StackPanel x:Name="SettingsPage"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSectionCode}" Value="Settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Grid x:Name="SettingsAppearanceLanguageRow"><Grid.ColumnDefinitions><ColumnDefinition Width="55*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions>
            <Border x:Name="SettingsAppearanceCard" Style="{StaticResource Card}" Margin="0,0,6,12"><StackPanel>
              <TextBlock Text="{DynamicResource Text.Appearance}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource Text.Theme}" Margin="0,12,0,0"/>
              <TextBlock Text="{DynamicResource Text.SystemFollowsTheWindowsPreferenceAtStartupOr}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
              <ComboBox x:Name="ThemeSelector" Margin="0,12,0,0" HorizontalAlignment="Left" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" Width="160" VerticalAlignment="Center">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel></Border>
              <Border x:Name="SettingsLanguageCard" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,12"><StackPanel>
                <TextBlock Text="{DynamicResource Text.Language}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Text.InterfaceLanguage}" Margin="0,12,0,4"/>
                <TextBlock Text="{DynamicResource Text.UpdatesTheInterfaceImmediately}" Style="{StaticResource Muted}" FontSize="12"/>
                <ComboBox x:Name="LanguageSelector" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" DisplayMemberPath="Name" Width="160" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="{DynamicResource Text.InterfaceLanguage}"/>
              </StackPanel></Border>
            </Grid>
            <Grid x:Name="SettingsDataPreferencesRow"><Grid.ColumnDefinitions><ColumnDefinition Width="55*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions>
              <Border x:Name="SettingsDataCard" Style="{StaticResource Card}" Margin="0,0,6,12"><StackPanel>
                <TextBlock Text="{DynamicResource Text.DataAndLogs}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Text.ConfigurationAndLogsAreStoredAlongsideTheApplication}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/>
                <WrapPanel><Button Content="{DynamicResource Text.OpenLogsFolder}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,6"/><Button Content="{DynamicResource Text.OpenWinserenoFolder}" Command="{Binding OpenApplicationFolderCommand}" Margin="0,0,0,6"/></WrapPanel>
              </StackPanel></Border>
              <Border x:Name="SettingsPreferencesCard" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,12"><StackPanel>
                <TextBlock Text="{DynamicResource Text.Preferences}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Text.RestoresTheDefaultAppearanceWithoutDeletingLogsOr}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/>
                <Button Content="{DynamicResource Text.ResetPreferences}" Command="{Binding ResetPreferencesCommand}" HorizontalAlignment="Left"/>
              </StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Text.About}" FontSize="18" FontWeight="SemiBold"/>
              <WrapPanel Margin="0,8,0,0"><TextBlock Text="{DynamicResource Text.Winsereno}" FontWeight="SemiBold" Margin="0,0,8,0"/><TextBlock Text="{Binding ProductVersion}" Style="{StaticResource Muted}"/></WrapPanel>
              <TextBlock Text="{DynamicResource Text.PortableNetFramework48NotDigitallySigned}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,4"/>
              <WrapPanel><Button Content="{DynamicResource Text.Github}" Command="{Binding OpenGitHubCommand}" Style="{StaticResource LinkButton}" Margin="0,0,20,0"/><Button Content="{DynamicResource Text.Releases}" Command="{Binding OpenReleasesCommand}" Style="{StaticResource LinkButton}" Margin="0"/></WrapPanel>
              <TextBlock Text="{DynamicResource Text.Updates}" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock Text="{DynamicResource Text.BuiltInUpdateCheckingWillBeAvailableIn}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,8"/>
              <Button Content="{DynamicResource Text.CheckForUpdates}" Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Left"/></StackPanel><Image x:Name="AboutBrandMark" Grid.Column="1" Source="{DynamicResource BrandMarkImage}" Width="56" Height="56" Stretch="Uniform" VerticalAlignment="Top" Margin="16,0,0,0" AutomationProperties.Name="{DynamicResource Text.WinserenoMark}"/></Grid>
            </StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Canvas x:Name="ToastLayer" Grid.RowSpan="3" Panel.ZIndex="20" Margin="8" SizeChanged="ToastLayer_SizeChanged">
        <ContentControl x:Name="TaskExecutionHost" Canvas.Right="0" Canvas.Bottom="0" Visibility="{Binding ShowTaskPanel, Converter={StaticResource BoolVisibility}}"/>
      </Canvas>
    </Grid>
  </Grid>
</Window>
