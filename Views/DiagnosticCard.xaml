<UserControl x:Class="WinSereno.Views.DiagnosticCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Tag" Value="False"/>
    <Style.Triggers>
      <!-- Tag marks only the initial presentation; real NotChecked results retain their content. -->
      <MultiDataTrigger><MultiDataTrigger.Conditions>
        <Condition Binding="{Binding StatusCode}" Value="NotChecked"/>
        <Condition Binding="{Binding HasDetails}" Value="False"/>
        <Condition Binding="{Binding Summary}" Value="Aún no se ha realizado esta comprobación."/>
        <Condition Binding="{Binding Recommendation}" Value="Pulsar Analizar este PC."/>
      </MultiDataTrigger.Conditions>
        <Setter Property="Tag" Value="True"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/>
      </MultiDataTrigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions>
        <Condition Binding="{Binding StatusCode}" Value="NotChecked"/>
        <Condition Binding="{Binding HasDetails}" Value="False"/>
        <Condition Binding="{Binding Summary}" Value="La comprobación de integridad requiere una acción administrativa explícita."/>
        <Condition Binding="{Binding Recommendation}" Value="Revisar las opciones de Reparación; no se ejecutará DISM en este análisis."/>
      </MultiDataTrigger.Conditions>
        <Setter Property="Tag" Value="True"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style></Border.Style><StackPanel>
    <DockPanel><TextBlock Text="{Binding StatusLabel}" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="16,0,0,0">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers>
        <DataTrigger Binding="{Binding StatusCode}" Value="Healthy"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding StatusCode}" Value="Attention"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding StatusCode}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
    </TextBlock><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/></DockPanel>
    <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding Summary}" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding Recommendation, StringFormat=Recomendación: {0}}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
    </StackPanel>
    <WrapPanel><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,12,0,0"/><Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Margin" Value="0,6,0,0"/></DataTrigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions>
        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
        <Condition Binding="{Binding HasDetails}" Value="False"/>
        <Condition Binding="{Binding HasNavigation}" Value="False"/>
      </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger>
    </Style.Triggers></Style></WrapPanel.Style>
      <Button Content="Ver detalles" Margin="0,0,8,6" Visibility="{Binding HasDetails, Converter={StaticResource BoolVisibility}}" Command="{Binding DataContext.Diagnosis.DetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
      <Button Content="{Binding NavigationLabel}" Margin="0,0,8,6" Visibility="{Binding HasNavigation, Converter={StaticResource BoolVisibility}}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding NavigationTarget}"/>
    </WrapPanel>
  </StackPanel></Border>
</UserControl>
