<Window x:Class="WinSereno.Views.TcpIpResetWarningWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="{DynamicResource Text.WarningBeforeResettingTcpIp}" Width="720" Height="620" MinWidth="540" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Text.Separator685}" FontFamily="Segoe UI Symbol" FontSize="42" Foreground="{DynamicResource WarningBrush}" Margin="0,0,16,0"/>
        <TextBlock Grid.Column="1" Text="{Binding Snapshot.WarningTitle}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </Grid>
      <Border Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="2" CornerRadius="6" Padding="14" Margin="0,14,0,12">
        <TextBlock Text="{Binding Snapshot.WarningMessage}" TextWrapping="Wrap" FontWeight="SemiBold"/>
      </Border>
      <TextBlock Text="{DynamicResource Text.MakeSureYouKnowYourIpAddressSubnet}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Snapshot.UnavailableNotice}" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><DataTrigger Binding="{Binding Snapshot.IsIndeterminate}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <ItemsControl ItemsSource="{Binding Snapshot.WarningInterfaces}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10"><StackPanel>
          <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ConfigurationLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Text.Ipv4}" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding IPv4}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Text="{DynamicResource Text.SubnetMaskPrefix}" Style="{StaticResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Mask}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="2" Text="{DynamicResource Text.Gateway}" Style="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Gateway}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="3" Text="{DynamicResource Text.Dns}" Style="{StaticResource Muted}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Dns}" TextWrapping="Wrap"/>
          </Grid>
        </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{DynamicResource Text.WinserenoDoesNotAutomaticallySaveOrRestoreThis}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1">
      <CheckBox x:Name="Acknowledgement" IsChecked="{Binding Acknowledged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,16" Foreground="{DynamicResource TextBrush}" HorizontalContentAlignment="Stretch"><TextBlock Text="{DynamicResource Text.IHaveReviewedMyNetworkConfigurationAndUnderstand}" TextWrapping="Wrap"/></CheckBox>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{DynamicResource Text.Cancel}" IsCancel="True"/>
        <Button x:Name="ResetButton" Content="{DynamicResource Text.ResetTcpIp}" IsEnabled="{Binding CanContinue}" Click="OnContinue" Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource WarningBrush}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
