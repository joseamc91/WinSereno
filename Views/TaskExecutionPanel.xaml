<UserControl x:Class="WinSereno.Views.TaskExecutionPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Margin="0" Visibility="{Binding ShowTaskPanel, Converter={StaticResource BoolVisibility}}">
    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Padding" Value="12"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding TaskName}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding StatusText}" Margin="0,5,0,0"/>
        <StackPanel Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding ElapsedText, StringFormat=Tiempo transcurrido: {0}}" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
        <TextBlock Text="{Binding Progress.LastRelevantLine}" Style="{StaticResource Muted}" Margin="0,5,12,0"/>
        <TextBlock Text="{Binding Progress.Percentage, StringFormat=Progreso real: {0:0.#}%}" Visibility="{Binding HasPercentage, Converter={StaticResource BoolVisibility}}"/>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress.Percentage}" IsIndeterminate="False" Height="6" Margin="0,10,12,0" Visibility="{Binding HasPercentage, Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Button Content="X" ToolTip="Ocultar resultado" AutomationProperties.Name="Ocultar resultado terminado" Command="{Binding DismissTaskPanelCommand}" HorizontalAlignment="Right" Padding="6,2" Margin="0,0,0,6" FontSize="12" Visibility="{Binding CanDismissTaskPanel, Converter={StaticResource BoolVisibility}}"/>
        <Button Content="Ver detalles" Command="{Binding DetailsCommand}" Margin="0,0,0,8"/>
        <Button Content="Cancelar tarea" Command="{Binding CancelTaskCommand}" Margin="0" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
