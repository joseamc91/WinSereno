  <!-- Render the clean official alpha silhouette in soft white; the white PNG has edge artifacts. -->
  <DrawingImage x:Key="BrandLogoImage"><DrawingImage.Drawing><DrawingGroup>
    <DrawingGroup.OpacityMask><ImageBrush ImageSource="/WinSereno;component/Assets/Brand/WinSereno-Logo-Horizontal-Dark.png" Stretch="Uniform"/></DrawingGroup.OpacityMask>
    <GeometryDrawing Brush="#F7F9FA" Geometry="M0,0 L2172,0 2172,724 0,724 Z"/>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="BrandMarkImage"><DrawingImage.Drawing><DrawingGroup>
    <DrawingGroup.OpacityMask><ImageBrush ImageSource="/WinSereno;component/Assets/Brand/WinSereno-Mark-Color.png" Stretch="Uniform"/></DrawingGroup.OpacityMask>
    <GeometryDrawing Brush="#F7F9FA" Geometry="M0,0 L1254,0 1254,1254 0,1254 Z"/>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
